# Godot 4+ specific ignores
.godot/
/android/

# Godot-specific ignores
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# OS / Editor ignores
.DS_Store
Thumbs.db
*.tmp

# Modelos 3D de Meshy (206 MB): fuera del repositorio; los renders sí se versionan
Art/Meshy/*.glb

# Reproducible character sources are kept; transient downloads/frames stay local.
Art/Meshy/prerendered/models/
Art/Meshy/prerendered/frames/
Art/Meshy/prerendered/rigs/**/meta.json
Art/Meshy/prerendered/sprites/
Art/Meshy/prerendered/before/
Art/Meshy/prerendered/*-existing-preview.png
Art/Meshy/prerendered/render_*diagnostic*.json
Art/Meshy/prerendered/render_*_poses_*.json
Art/Meshy/prerendered/render_*_Hurt.json
Art/Meshy/prerendered/render_*_Dead.json

__pycache__/
*.py[cod]

# Intermediate v2 renders and temporary signed download metadata
Art/Meshy/animation_v2/frames/
Art/Meshy/animation_v2/**/meta.json
